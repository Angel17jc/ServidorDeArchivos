    {
      "name": "2. Orquestador",
      "item": [
        {
          "name": "Flujo normal (propaga clase-101)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "clase-101"
              }
            ],
            "url": {
              "raw": "{{orquestador}}/api/resumen-solicitud/101",
              "host": [
                "{{orquestador}}"
              ],
              "path": [
                "api",
                "resumen-solicitud",
                "101"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('correlation_id = clase-101', () => pm.expect(pm.response.json().correlation_id).to.eql('clase-101'));",
                  "pm.test('Cabecera X-Correlation-ID = clase-101', () => pm.response.to.have.header('X-Correlation-ID', 'clase-101'));",
                  "pm.test('Respuesta unificada', () => { const j = pm.response.json(); pm.expect(j.solicitud_id).to.eql(101); pm.expect(j.usuario).to.eql({id: 7, nombre: 'Ana'}); pm.expect(j.estado).to.eql({solicitud_id: 101, estado: 'pendiente'}); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Sin cabecera (genera UUID)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{orquestador}}/api/resumen-solicitud/101",
              "host": [
                "{{orquestador}}"
              ],
              "path": [
                "api",
                "resumen-solicitud",
                "101"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('correlation_id es un UUID generado', () => pm.expect(pm.response.json().correlation_id).to.match(/^[0-9a-f-]{36}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Fallo: servicio detenido (Ctrl+C en estados)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "clase-101"
              }
            ],
            "url": {
              "raw": "{{orquestador}}/api/resumen-solicitud/101",
              "host": [
                "{{orquestador}}"
              ],
              "path": [
                "api",
                "resumen-solicitud",
                "101"
              ]
            },
            "description": "Antes de enviar, detén el servicio de estados con Ctrl+C en su ventana."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 502', () => pm.response.to.have.status(502));",
                  "pm.test('Mensaje controlado', () => pm.expect(pm.response.json().error).to.eql('Dependencia no disponible'));",
                  "pm.test('Sin trazas', () => pm.expect(Object.keys(pm.response.json())).to.eql(['error', 'correlation_id']));",
                  "pm.test('Conserva el correlation_id', () => pm.expect(pm.response.json().correlation_id).to.eql('clase-101'));"
                ]
              }
            }
          ]
        },
