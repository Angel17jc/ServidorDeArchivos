# Copiar a .env y cambiar la clave. Debe ser la misma que use el backend (L3).
FILES_API_KEY=cambia-esta-clave-compartida
MAX_FILE_SIZE_MB=10
# URL pública con la que se devuelven los archivos (a través de NGINX en L1)
PUBLIC_BASE_URL=http://192.168.10.11/files
# Puerto publicado en el equipo anfitrión (para acceso desde otros computadores)
L5_HOST_PORT=8080
